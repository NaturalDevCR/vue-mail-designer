{
  "name": "@naturaldevcr/vue-mail-designer",
  "version": "0.3.5",
  "description": "A visual drag & drop email builder for Vue 3. Exports email-client-compatible HTML and a re-editable design JSON.",
  "license": "MIT",
  "author": "Josue <josue@symphonycr.com>",
  "homepage": "https://naturaldevcr.github.io/vue-mail-designer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NaturalDevCR/vue-mail-designer",
    "directory": "packages/email-builder"
  },
  "bugs": "https://github.com/NaturalDevCR/vue-mail-designer/issues",
  "keywords": [
    "vue",
    "vue3",
    "email",
    "email-builder",
    "email-editor",
    "drag-and-drop",
    "html-email",
    "newsletter",
    "unlayer"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/vue-mail-designer.css"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.0.0",
    "@tiptap/core": "^2.26.0",
    "@tiptap/extension-link": "^2.26.0",
    "@tiptap/extension-text-align": "^2.26.0",
    "@tiptap/extension-underline": "^2.26.0",
    "@tiptap/pm": "^2.26.0",
    "@tiptap/starter-kit": "^2.26.0",
    "@tiptap/vue-3": "^2.26.0",
    "vue-advanced-cropper": "^2.8.9",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "pinia": "^2.2.0 || ^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "pinia": "^3.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
