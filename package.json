{
  "name": "vue-mail-designer",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Monorepo de vue-mail-designer: email builder visual drag & drop para Vue 3.",
  "homepage": "https://naturaldevcr.github.io/vue-mail-designer/",
  "repository": { "type": "git", "url": "https://github.com/NaturalDevCR/vue-mail-designer.git" },
  "bugs": "https://github.com/NaturalDevCR/vue-mail-designer/issues",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter @vue-mail-designer/builder build && pnpm --filter demo build",
    "test": "pnpm --filter @vue-mail-designer/builder test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "vue-demi"]
  },
  "engines": { "node": ">=20" }
}
